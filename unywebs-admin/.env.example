# Same Supabase project as the website and UnyBase. Only the public
# anon key is needed: every write runs as the signed-in admin, and row
# level security decides what they may change. There is deliberately no
# service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://uwomibcrrrahucqtsvte.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public website this admin publishes to, and the shared secret its
# /api/revalidate route expects. Use https://unywebs.com once DNS points
# there; until then, the site's *.vercel.app address.
MARKETING_SITE_URL=https://unywebs.com
REVALIDATE_SECRET=

# Vercel automation bypass for the site's protected *.vercel.app
# hostnames. Unused once MARKETING_SITE_URL is the custom domain.
MARKETING_SITE_BYPASS_SECRET=

# Where the UnyBase product lives, for the Products section.
UNYBASE_APP_URL=https://unybase.unywebs.com
UNYBASE_SITE_URL=https://tryunybase.unywebs.com

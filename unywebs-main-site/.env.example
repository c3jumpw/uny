# Public read of published content. Safe to expose — RLS limits the
# anon key to rows where status = 'published'.
NEXT_PUBLIC_SUPABASE_URL=https://uwomibcrrrahucqtsvte.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret the admin app sends when it asks this site to rebuild a
# page after publishing. Must match REVALIDATE_SECRET in the admin app.
REVALIDATE_SECRET=

# Canonical origin, used for sitemap.xml and og: URLs.
NEXT_PUBLIC_SITE_URL=https://unywebs.com
